 },
 "styles": {
  "color": {
   "background": "var:preset|color|base",
   "text": "var:preset|color|contrast"
  },
  "spacing": {
   "blockGap": "var:preset|spacing|20",
   "padding": {
    "left": "var:preset|spacing|30",
    "right": "var:preset|spacing|30"
   }
  },
  "typography": {
   "fontFamily": "var:preset|font-family|sabon",
   "fontSize": "var:preset|font-size|medium",
   "fontWeight": "400",
   "lineHeight": "1.6",
   "letterSpacing": "0"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var:preset|font-family|garamond",
     "fontWeight": "600",
     "lineHeight": "1.1",
     "letterSpacing": "-0.01em"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var:preset|font-size|xx-large"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var:preset|font-size|x-large"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var:preset|font-size|large"
    }
   },
   "h4": {
    "typography": {
     "fontSize": "var:preset|font-size|medium",
     "fontFamily": "var:preset|font-family|garamond"
    }
   },
   "h5": {
    "typography": {
     "fontSize": "var:preset|font-size|small",
     "fontFamily": "var:preset|font-family|garamond"
    }
   },
   "h6": {
    "typography": {
     "fontSize": "var:preset|font-size|small",
     "fontFamily": "var:preset|font-family|evangelion",
     "textTransform": "uppercase",
     "letterSpacing": "0.12em"
    }
   },
   "link": {
    "color": {
     "text": "var:preset|color|accent-1"
    },
    "typography": {
     "textDecoration": "underline"
    },
    ":hover": {
     "color": {
      "text": "var:preset|color|accent-2"
     }
    }
   },
   "button": {
    "border": {
     "radius": "999px"
    },
    "color": {
     "background": "var:preset|color|accent-1",
     "text": "var:preset|color|base"
    },
    "spacing": {
     "padding": {
      "top": "11px",
      "bottom": "11px",
      "left": "22px",
      "right": "22px"
     }
    },
    "typography": {
     "fontFamily": "var:preset|font-family|garamond",
     "fontSize": "var:preset|font-size|medium",
     "fontWeight": "600"
    },
    ":hover": {
     "color": {
      "background": "var:preset|color|green-deep",
      "text": "var:preset|color|base"
     }
    },
    ":focus": {
     "outline": {
      "color": "var:preset|color|accent-3",
      "offset": "3px",
      "style": "solid",
      "width": "2px"
     }
    }
   },
   "caption": {
    "typography": {
     "fontSize": "var:preset|font-size|small"
    },
    "color": {
     "text": "var:preset|color|muted"
    }
   }
  },
  "blocks": {
   "core/separator": {
    "border": {
     "width": "1px 0 0 0",
     "color": "var:preset|color|accent-6",
     "style": "solid"
    },
    "color": {
     "text": "var:preset|color|accent-6"
    }
   },
   "core/button": {
    "variations": {
     "outline": {
      "border": {
       "width": "1.5px",
       "color": "var:preset|color|accent-1",
       "radius": "999px"
      },
      "color": {
       "background": "transparent",
       "text": "var:preset|color|accent-1"
      },
      "spacing": {
       "padding": {
        "top": "9.5px",
        "bottom": "9.5px",
        "left": "20.5px",
        "right": "20.5px"
       }
      }
     }
    }
   },
   "core/quote": {
    "border": {
     "radius": "14px",
     "width": "0"
    },
    "color": {
     "background": "var:preset|color|accent-5"
    },
    "spacing": {
     "padding": {
      "top": "var:preset|spacing|30",
      "bottom": "var:preset|spacing|30",
      "left": "var:preset|spacing|30",
      "right": "var:preset|spacing|30"
     }
    },
    "typography": {
     "fontFamily": "var:preset|font-family|garamond",
     "fontSize": "var:preset|font-size|large",
     "fontStyle": "italic"
    }
   },
   "core/pullquote": {
    "border": {
     "radius": "22px",
     "width": "0"
    },
    "color": {
     "background": "var:preset|color|green-tint",
     "text": "var:preset|color|accent-1"
    },
    "typography": {
     "fontFamily": "var:preset|font-family|garamond",
     "fontSize": "var:preset|font-size|x-large",
     "fontWeight": "500",
     "textAlign": "left"
    }
   },
   "core/site-title": {
    "typography": {
     "fontFamily": "var:preset|font-family|kagnue",
     "fontSize": "var:preset|font-size|x-large",
     "fontWeight": "400",
     "letterSpacing": "-0.01em"
    },
    "elements": {
     "link": {
      "color": {
       "text": "var:preset|color|accent-1"
      },
      "typography": {
       "textDecoration": "none"
      }
     }
    }
   },
   "core/navigation": {
    "typography": {
     "fontSize": "var:preset|font-size|small",
     "fontWeight": "500",
     "fontFamily": "var:preset|font-family|evangelion"
    },
    "elements": {
     "link": {
      "typography": {
       "textDecoration": "none"
      },
      ":hover": {
       "color": {
        "text": "var:preset|color|accent-2"
       }
      }
     }
    }
   },
   "core/post-terms": {
    "typography": {
     "fontSize": "var:preset|font-size|small",
     "fontWeight": "600",
     "textTransform": "uppercase",
     "letterSpacing": "0.12em",
     "fontFamily": "var:preset|font-family|evangelion"
    },
    "elements": {
     "link": {
      "color": {
       "text": "var:preset|color|accent-2"
      },
      "typography": {
       "textDecoration": "none"
      }
     }
    }
   },
   "core/post-date": {
    "typography": {
     "fontSize": "var:preset|font-size|small"
    },
    "color": {
     "text": "var:preset|color|muted"
    }
   },
   "core/post-title": {
    "elements": {
     "link": {
      "color": {
       "text": "var:preset|color|contrast"
      },
      "typography": {
       "textDecoration": "none"
      },
      ":hover": {
       "color": {
        "text": "var:preset|color|accent-1"
       }
      }
     }
    }
   },
   "core/search": {
    "border": {
     "radius": "999px"
    }
   },
   "core/code": {
    "border": {
     "radius": "8px",
     "width": "0"
    },
    "color": {
     "background": "var:preset|color|accent-5"
    },
    "typography": {
     "fontFamily": "var:preset|font-family|special-elite"
    }
   },
   "core/table": {
    "typography": {
     "fontSize": "var:preset|font-size|small"
    }
   },
   "core/image": {
    "border": {
     "radius": "14px"
    }
   }
  }
 },
 "customTemplates": [
  {
   "name": "page-wide",
   "title": "Wide page (tables)",
   "postTypes": [
    "page",
    "post"
   ]
  },
  {
   "name": "page-section",
   "title": "Section index",
   "postTypes": [
    "page"
   ]
  }
 ],
 "templateParts": [
  {
   "name": "header",
   "title": "Header",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer",
   "area": "footer"
  }
 ]
}