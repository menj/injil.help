     "slug": "medium",
     "size": "18px",
     "fluid": false
    },
    {
     "name": "Large",
     "slug": "large",
     "size": "22px",
     "fluid": {
      "min": "20px",
      "max": "22px"
     }
    },
    {
     "name": "Extra Large",
     "slug": "x-large",
     "size": "34px",
     "fluid": {
      "min": "27px",
      "max": "34px"
     }
    },
    {
     "name": "Extra Extra Large",
     "slug": "xx-large",
     "size": "68px",
     "fluid": {
      "min": "42px",
      "max": "68px"
     }
    }
   ]
